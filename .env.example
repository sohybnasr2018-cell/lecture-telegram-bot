# توكن بوت التيليجرام من BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# مفتاح Gemini API المجاني من Google AI Studio (https://aistudio.google.com/)
# يمكنك وضع مفتاح واحد أو عدة مفاتيح مجانية مفصولة بفواصل للتدوير التلقائي وتوزيع الضغط لآلاف الطلاب:
GEMINI_API_KEYS=your_first_free_key,your_second_free_key

# الموديل الافتراضي
GEMINI_MODEL=gemini-3.8-flash

# مسار مجلد التخزين المؤقت
TEMP_DIR=./temp
